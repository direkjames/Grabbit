{
  "name": "grabbit",
  "productName": "Grabbit",
  "version": "1.1.2",
  "description": "Grab videos and audio as MP4, MP3 or WAV. A friendly desktop app powered by yt-dlp.",
  "author": "direk james",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "fetch-bins": "node scripts/fetch-binaries.js",
    "icon": "node scripts/set-icon.js",
    "postinstall": "node scripts/fetch-binaries.js",
    "predist": "node scripts/fetch-binaries.js",
    "dist": "electron-builder --win --x64 --publish never",
    "pack": "electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.direkjames.grabbit",
    "productName": "Grabbit",
    "copyright": "Copyright © 2026 direk james",
    "publish": [
      {
        "provider": "github",
        "owner": "direkjames",
        "repo": "grabbit",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe",
          "deno.exe"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grabbit",
      "artifactName": "Grabbit-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Grabbit-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
